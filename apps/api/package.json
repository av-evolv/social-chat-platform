    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
