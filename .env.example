# Local development only. Compose binds published ports to loopback.
POSTGRES_DB=larynx
POSTGRES_USER=larynx
POSTGRES_PASSWORD=larynx-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://larynx:larynx-local-only@127.0.0.1:5432/larynx
HOST=0.0.0.0
PORT=3000
API_PORT=3000
WEB_PORT=8088
GARAGE_PORT=3900
GARAGE_RPC_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GARAGE_DEFAULT_ACCESS_KEY=GK11111111111111111111111111111111
GARAGE_DEFAULT_SECRET_KEY=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
GARAGE_DEFAULT_BUCKET=larynx-media
S3_REGION=garage
S3_ENDPOINT=http://127.0.0.1:3900
# Public URL is used when signing client requests. Container server calls use http://garage:3900.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:3900
CLIENT_ORIGIN=http://127.0.0.1:8088
API_ORIGIN=http://127.0.0.1:3000

# Local email capture (never forwards mail)
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
